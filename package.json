{
  "name": "design-studio",
  "productName": "Design Studio",
  "version": "0.1.0",
  "description": "AI-powered graphic design and creative studio for Windows (Electron).",
  "main": "main/main.js",
  "author": "jawedsyed64",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/model.test.js",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jawedsyed64.designstudio",
    "productName": "Design Studio",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "dstudio",
        "name": "Design Studio Project",
        "description": "Design Studio Project"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Design Studio"
    },
    "portable": {
      "artifactName": "DesignStudio-Portable-${version}.exe"
    }
  }
}
